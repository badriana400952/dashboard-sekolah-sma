// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TahunAjaran {
  id            Int          @id @default(autoincrement())
  nama          String
  tahun_mulai   DateTime
  tahun_selesai DateTime
  is_active     Boolean      @default(false)
  created_at    DateTime     @default(now())
  kelas_siswa   KelasSiswa[]
  siswa         Siswa[]
  Rapor         Rapor[]
}

model Siswa {
  id                 Int      @id @default(autoincrement())
  nis                Int      @unique
  nama_siswa         String
  nama_lengkap_siswa String
  jenis_kelamin      String
  ttl                DateTime
  agama              String
  nama_ibu           String
  no_hp_ortu         String
  email_ortu         String
  created_at         DateTime @default(now())

  kelas_id        Int?
  tahun_ajaran_id Int?

  kelas        Kelas?       @relation(fields: [kelas_id], references: [id], onDelete: Cascade)
  tahun_ajaran TahunAjaran? @relation(fields: [tahun_ajaran_id], references: [id], onDelete: Cascade)

  kelas_siswa KelasSiswa[]
  rapor       Rapor[]
}

model Kelas {
  id          Int          @id @default(autoincrement())
  nama        String
  tingkat     Int
  jurusan     String
  siswa       Siswa[]
  kelas_siswa KelasSiswa[]
  created_at  DateTime     @default(now())
  Rapor       Rapor[]
}

model KelasSiswa {
  id Int @id @default(autoincrement())

  kelas_id        Int
  siswa_id        Int
  tahun_ajaran_id Int

  siswa        Siswa       @relation(fields: [siswa_id], references: [id])
  kelas        Kelas       @relation(fields: [kelas_id], references: [id])
  tahun_ajaran TahunAjaran @relation(fields: [tahun_ajaran_id], references: [id])

  created_at DateTime @default(now())

  @@unique([siswa_id, kelas_id, tahun_ajaran_id])
}

model Matapelajaran {
  id                         Int      @id @default(autoincrement())
  created_at                 DateTime @default(now())
  pendidikan_agama           String
  pendidikan_kewarganegaraan String
  bahasa_indonesia           String
  bahasa_inggris             String
  bahasa_jawa                String
  matematika                 String
  ilmu_pengetahuan_alam      String
  ilmu_pengetahuan_sosial    String
  seni_budaya                String
  penjas                     String
}

model Rapor {
  id              Int  @id @default(autoincrement())
  id_siswa        Int?
  id_kelas        Int?
  id_tahun_ajaran Int?

  siswa                      Siswa?       @relation(fields: [id_siswa], references: [id], onDelete: Cascade)
  kelas                      Kelas?       @relation(fields: [id_kelas], references: [id], onDelete: Cascade)
  tahun_ajaran               TahunAjaran? @relation(fields: [id_tahun_ajaran], references: [id], onDelete: Cascade)
  bahasa_indonesia           Int
  pendidikan_agama           Int
  ilmu_pengetahuan_alam      Int
  seni_budaya                Int
  bahasa_inggris             Int
  pendidikan_kewarganegaraan Int
  matematika                 Int
  ilmu_pengetahuan_sosial    Int
  bahasa_jawa                Int
  penjaskes                Int

  created_at DateTime @default(now())

  @@unique([id_kelas, id_siswa, id_tahun_ajaran])
}
